# =============================================================================
# Kamal Medical Hall Mobile App Configuration
# =============================================================================
# Copy this to .env and fill in your values
# Get EXPO_PUBLIC_API_URL from your backend server URL

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Your backend API URL (required)
# Get from your hosting provider (Render, Vercel, etc.)
# Example: https://api.kamalmedicalhall.com
EXPO_PUBLIC_API_URL=

# =============================================================================
# AUTHENTICATION MODE
# =============================================================================
# dev: OTP 123456 for testing (NOT allowed in production app)
# firebase: Firebase Phone Authentication (requires google-services.json/GoogleService-Info.plist)
EXPO_PUBLIC_AUTH_MODE=dev

# =============================================================================
# API TRANSPORT
# =============================================================================
# socket: every API request goes over socket.io (default)
# http: plain HTTPS for server not yet in socket-only mode
EXPO_PUBLIC_API_TRANSPORT=

# =============================================================================
# CRASH REPORTING (optional)
# =============================================================================
# Get from Sentry Dashboard → Project Settings → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=