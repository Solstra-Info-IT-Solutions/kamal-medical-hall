# =============================================================================
# Kamal Medical Hall API Configuration - MongoDB Edition
# =============================================================================

NODE_ENV=development
PORT=4000

# =============================================================================
# DATABASE (Choose ONE: MongoDB OR PostgreSQL/Supabase)
# =============================================================================
# MONGODB (Recommended for faster setup)
# Get from MongoDB Atlas → Connect → Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kamal-medical-hall?retryWrites=true&w=majority

# POSTGRESQL/Supabase (Alternative - keep as fallback)
# DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/kamal-medical-hall

# =============================================================================
# AUTHENTICATION
# dev | firebase | twilio | sms
# - dev: enables OTP 123456 login (ONLY for development, rejected in production)
# - firebase: Firebase Phone Authentication (requires FIREBASE_PROJECT_ID)
# - twilio: Twilio Verify OTP (requires TWILIO_ACCOUNT_SID, etc.)
# - sms: PearlSMS gateway (requires SMS settings in admin panel, CLOUDINARY config)
# =============================================================================
AUTH_MODE=dev
JWT_SECRET=your-32-character-secret-key-here-change-this-minimum

# Firebase configuration (required when AUTH_MODE=firebase)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Bootstrap admin phone numbers (comma-separated, admin role)
BOOTSTRAP_ADMIN_PHONES=9000000001

# =============================================================================
# THIRD-PARTY SERVICES
# =============================================================================
# Cloudinary for file uploads (prescriptions, profile photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay for payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# =============================================================================
# BUSINESS SETTINGS
# =============================================================================
MIN_LEAD_MINUTES=60
QUOTE_VALID_HOURS=24

# =============================================================================
# SERVER SETTINGS
# =============================================================================
# Public address of this API (no trailing slash). Required behind nginx.
# Example: https://api.kamalmedicalhall.com
PUBLIC_URL=https://api.kamalmedicalhall.com

# Browser origins allowed to call the API (comma-separated). Native apps unaffected.
CORS_ORIGINS=https://admin.kamalmedicalhall.com,https://www.kamalmedicalhall.com

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
# Structured request log lines: on | off. Defaults to on in production.
LOG_REQUESTS=

# Sentry error reporting (optional)
SENTRY_DSN=

# =============================================================================
# API TRANSPORT
# =============================================================================
# socket: JSON API over socket.io (plain HTTP returns 426)
# Leave empty for HTTP-only mode
API_TRANSPORT=

# =============================================================================
# ENVIRONMENT VARIABLES FOR RENDER/DEPLOYMENT
# =============================================================================
# NODE_ENV=production
# PORT=4000
