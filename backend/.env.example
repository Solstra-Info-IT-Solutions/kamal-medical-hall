NODE_ENV=development
PORT=4000
DATABASE_URL=
# dev | firebase.  "dev" enables OTP 123456 login and is refused when NODE_ENV=
AUTH_MODE=dev
JWT_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
BOOTSTRAP_ADMIN_PHONES=9000000001
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MIN_LEAD_MINUTES=60
QUOTE_VALID_HOURS=24
# Browser origins allowed to call the API (the web admin), comma separated. Native apps are unaffected. Example: https://admin.example.com
CORS_ORIGINS=
# PEM text of the database CA certificate (use \n for new lines). When set, the database TLS connection is verified.
DATABASE_CA=
# Set to "on" to verify the database's TLS certificate using the Supabase CA that ships with the API.
DATABASE_SSL_VERIFY=
# Structured request log lines: on | off. Defaults to on in production.
LOG_REQUESTS=
# Error reporting (optional)
SENTRY_DSN=
